# Orsomarso Performance App
# Copy this file to .env.local for local development.
# Never commit .env.local to GitHub.

# Safe default: local-only mode.
NEXT_PUBLIC_ENABLE_REMOTE_SYNC=false
NEXT_PUBLIC_REMOTE_SYNC_MODE=disabled

# Supabase table-based sync.
# Use only after running SUPABASE_RUN_THIS.sql and creating a Supabase Auth user.
# NEXT_PUBLIC_ENABLE_REMOTE_SYNC=true
# NEXT_PUBLIC_REMOTE_SYNC_MODE=table_schema
NEXT_PUBLIC_SUPABASE_URL=

# Use one of these keys. The app supports both names.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local category gate. Keep true while testing locally.
# For a public production line, replace local demo auth with a stricter auth flow.
NEXT_PUBLIC_ENABLE_LOCAL_DEMO_AUTH=true
