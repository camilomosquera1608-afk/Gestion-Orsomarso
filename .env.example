# Orsomarso Performance App
# Copy this file to .env.local for local development.
# Never commit .env.local to GitHub.

# ============================================
# CONFIGURACIÓN DE SINCRONIZACIÓN REMOTA
# ============================================

# Habilitar sincronización con Supabase
# true: Activa sincronización con Supabase
# false: Modo local-only (sin conexión a Supabase)
NEXT_PUBLIC_ENABLE_REMOTE_SYNC=true

# Modo de sincronización
# table_schema: Usa tablas de Supabase (recomendado)
# legacy_app_state: Usa estado legacy (obsoleto)
NEXT_PUBLIC_REMOTE_SYNC_MODE=table_schema

# ============================================
# CONFIGURACIÓN DE SUPABASE
# ============================================

# URL de tu proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://mijswozgoezmjbxtmdsj.supabase.co

# Clave anónima de Supabase (NUNCA compartirla públicamente)
# Puedes usar NEXT_PUBLIC_SUPABASE_ANON_KEY o NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu_clave_aqui

# ============================================
# CONFIGURACIÓN DE MODO DEMO LOCAL
# ============================================

# Habilitar modo demo local para pruebas sin Supabase
# true: Permite login con credenciales demo locales
# false: Solo permite login con Supabase
# RECOMENDACIÓN: true para desarrollo, false para producción
NEXT_PUBLIC_ENABLE_LOCAL_DEMO_AUTH=true

# ============================================
# NOTAS DE CONFIGURACIÓN
# ============================================

# Para desarrollo local:
# - NEXT_PUBLIC_ENABLE_REMOTE_SYNC=true
# - NEXT_PUBLIC_REMOTE_SYNC_MODE=table_schema
# - NEXT_PUBLIC_ENABLE_LOCAL_DEMO_AUTH=true

# Para producción:
# - NEXT_PUBLIC_ENABLE_REMOTE_SYNC=true
# - NEXT_PUBLIC_REMOTE_SYNC_MODE=table_schema
# - NEXT_PUBLIC_ENABLE_LOCAL_DEMO_AUTH=false

# Para modo offline/local:
# - NEXT_PUBLIC_ENABLE_REMOTE_SYNC=false
# - NEXT_PUBLIC_ENABLE_LOCAL_DEMO_AUTH=true
